{
  "name": "breakhound-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/analyzers",
    "packages/engine",
    "packages/report",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build:analyzers": "node packages/analyzers/build.mjs",
    "dev": "npm run build:analyzers && tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/analyzers && tsc -p packages/engine && tsc -p packages/report && tsc -p packages/cli",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
