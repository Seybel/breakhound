{
  "name": "breakhound-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/analyzers",
    "packages/engine",
    "packages/routes",
    "packages/source",
    "packages/report",
    "packages/cli",
    "packages/extension"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build:analyzers": "node packages/analyzers/build.mjs",
    "dev": "npm run build:analyzers && tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/analyzers && tsc -p packages/engine && tsc -p packages/routes && tsc -p packages/source && tsc -p packages/report && tsc -p packages/cli && tsc -p packages/extension && tsc -p tsconfig.configs.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "npm run build -w @seybel/breakhound",
    "build:extension": "npm run build:analyzers && npm run build -w @breakhound/extension",
    "build:extension:store": "npm run build:analyzers && npm run build -w @breakhound/extension -- --store",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.0.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  }
}
