{
  "name": "breakhound",
  "version": "1.0.0",
  "description": "Find where your layout breaks across every viewport width, then hand the fix to your coding agent.",
  "keywords": [
    "responsive",
    "breakpoints",
    "layout",
    "overflow",
    "css",
    "playwright",
    "mcp"
  ],
  "homepage": "https://github.com/Seybel/breakhound#readme",
  "bugs": {
    "url": "https://github.com/Seybel/breakhound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seybel/breakhound.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Seybel",
  "type": "module",
  "bin": {
    "breakhound": "./bin/breakhound.cjs"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build && cp ../../README.md ../../LICENSE .",
    "smoke": "node smoke.mjs"
  },
  "engines": {
    "node": ">=20.16"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@breakhound/analyzers": "*",
    "@breakhound/engine": "*",
    "@breakhound/report": "*",
    "@breakhound/routes": "*",
    "@breakhound/source": "*",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "module": "./dist/index.js"
}
