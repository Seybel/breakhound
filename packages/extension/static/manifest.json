{
  "manifest_version": 3,
  "key": "",
  "name": "breakhound",
  "version": "0.0.0",
  "description": "Find responsive layout bugs at the exact widths they break. Right-click any page to scan it.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "breakhound: find where this page breaks",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["debugger", "contextMenus", "sidePanel"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
