{
  "manifest_version": 3,
  "name": "breakhound",
  "version": "0.0.0",
  "description": "Finds responsive layout bugs at the exact widths they happen, in a DevTools panel.",
  "devtools_page": "devtools.html",
  "permissions": ["debugger"],
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
